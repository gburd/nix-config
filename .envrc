NIX_CONFIG="experimental-features = nix-command flakes"
NIXPKGS_ALLOW_UNFREE=1
GPG_TTY=$(tty)
use flake

# One-time opt-in: a mistakenly committed imapsync log (private mail metadata)
# had to be purged from public history with a force-push. See the steering rule
# about `git add -A`. Remove this line once that cleanup is done.
use git_policy allow-force-push
