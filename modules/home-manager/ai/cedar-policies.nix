{ lib }:
# One Cedar policy set for every agent (maki natively, pi via the cedar
# extension), served by cedar-store on meh. Generated from the same sources as
# maki's permissions.toml so the two never drift: the bash allow/deny lists in
# ./bash-allowlist.nix and the file deny lists below.
#
# Model (maki-cedar): principal Agent::"<agent>", action Action::"invoke",
# resource Tool::"<tool key>", context { tool, scope }. A forbid denies (and
# wins), a permit allows, and no match falls back to the agent's own default.
# `~/` in a scope pattern is expanded to $HOME by the evaluating agent.
let
  bashAllowlist = import ./bash-allowlist.nix { inherit lib; };

  esc = s: lib.replaceStrings [ "\\" "\"" ] [ "\\\\" "\\\"" ] s;
  # A readable prefix plus a hash of the exact pattern: patterns that differ
  # only by case or punctuation must stay distinct, and heads like `[` have no
  # letters at all.
  slug = s:
    let
      word = lib.toLower (lib.concatStrings (builtins.filter (c: builtins.match "[A-Za-z0-9]" c != null) (lib.stringToCharacters s)));
    in
    "${lib.substring 0 24 word}-${lib.substring 0 8 (builtins.hashString "sha256" s)}";

  policy = { id, effect, tool, scope ? null }:
    let
      when = lib.optionalString (scope != null) " when { context.scope like \"${esc scope}\" }";
    in
    "@id(\"${id}\")\n${effect}(principal, action, resource == Tool::\"${tool}\")${when};\n";

  bashDeny = map (p: policy { id = "bash-deny-${slug p}"; effect = "forbid"; tool = "bash"; scope = p; }) bashAllowlist.makiDeny;
  bashAllow = map (p: policy { id = "bash-allow-${slug p}"; effect = "permit"; tool = "bash"; scope = p; }) bashAllowlist.makiAllow;

  # Credentials and shell init: never read or edited by an agent.
  secretPaths = [ "~/.ssh/*" "~/.gnupg/*" "~/.aws/*" "~/.config/gh/*" "~/.git-credentials" "~/.docker/config.json" "~/.kube/*" "~/.npmrc" "~/.pypirc" "~/.config/sops-nix/*" "~/.config/litellm/keys/*" ];
  shellInit = [ "~/.bashrc" "~/.zshrc" ];
  fileDeny =
    lib.concatMap
      (p: [
        (policy { id = "read-deny-${slug p}"; effect = "forbid"; tool = "read"; scope = p; })
        (policy { id = "edit-deny-${slug p}"; effect = "forbid"; tool = "edit"; scope = p; })
        (policy { id = "write-deny-${slug p}"; effect = "forbid"; tool = "write"; scope = p; })
      ])
      secretPaths
    ++ lib.concatMap
      (p: [
        (policy { id = "edit-deny-${slug p}"; effect = "forbid"; tool = "edit"; scope = p; })
        (policy { id = "write-deny-${slug p}"; effect = "forbid"; tool = "write"; scope = p; })
      ])
      shellInit;

  header = ''
    // Generated by modules/home-manager/ai/cedar-policies.nix -- do not edit.
    // Sources: bash-allowlist.nix (bash), cedar-policies.nix (file paths).

  '';
in
{
  text = header + lib.concatStrings (bashDeny ++ fileDeny ++ bashAllow);
  counts = {
    forbid = builtins.length bashDeny + builtins.length fileDeny;
    permit = builtins.length bashAllow;
  };
}
